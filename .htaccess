# Ssemu site on Hostinger (Apache/LiteSpeed)
Options -MultiViews
RewriteEngine On

# Force HTTPS and drop www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://ssemucleaningservices.com%{REQUEST_URI} [L,R=301]

# Single-page app: send unknown paths (/about, /services...) to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Cache hashed assets and media for a year, never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|webp|jpg|jpeg|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
AddType video/mp4 .mp4
AddType image/webp .webp
